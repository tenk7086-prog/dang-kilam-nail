# Không copy key Supabase ra frontend. SUPABASE_URL và SUPABASE_SERVICE_ROLE_KEY
# được Supabase cung cấp sẵn trên hosted Edge Functions.
ALLOWED_ORIGINS=https://TEN_WEBSITE_CUA_BAN.pages.dev,http://localhost:5173
GOOGLE_CALENDAR_ID=DIEN_CALENDAR_ID
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"DIEN_EMAIL","private_key":"DIEN_KHOA"}
CALENDAR_WORKER_TOKEN=DIEN_64_KY_TU_HEX_NGAU_NHIEN
# Để trống mặc định. Chỉ bật header IP sau khi kiểm chứng proxy xoá/ghi đè giá trị giả.
TRUSTED_CLIENT_IP_HEADER=
IP_HASH_SECRET=DIEN_SECRET_RIENG_NEU_BAT_IP
